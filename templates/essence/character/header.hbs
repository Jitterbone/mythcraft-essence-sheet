{{!-- ============================================================
     MythCraft Essence Sheet — Character Header
     Context: actor, system, systemSource, originsList, classesDisplay,
              hpPct, shieldPct, apPct, sapPct, spPct, isBloodied, sizeOptions, editable
     ============================================================ --}}
<header class="sheet-header">

  <div class="header-outer-layout">

    {{!-- 1. Enlarged Portrait on the Left --}}
    <div class="portrait-box {{#if isDead}}is-dead{{/if}}"
         data-action="editImage"
         title="{{#if isDead}}Character is Dead (Max Death Points Reached){{else}}Click to change character portrait{{/if}}">
      <img class="portrait-img"
           src="{{document.img}}"
           alt="{{document.name}}"
           data-action="editImage" />
      {{#if isDead}}
        <div class="dead-banner-overlay">DEAD</div>
      {{/if}}
      <div class="portrait-overlay">
        <i class="fas fa-camera"></i>
      </div>
    </div>

    {{!-- 2. Right Side Content --}}
    <div class="header-right-content">
      
      {{!-- Top Bar: Character Name + Combat Badges (Initiative & LP Side by Side) --}}
      <div class="header-top-bar">
        
        {{!-- Character Name --}}
        <div class="name-container">
          <input class="character-name-input"
                 type="text"
                 name="name"
                 value="{{document.name}}"
                 placeholder="Character Name" />
        </div>

        {{!-- Combat Badges: Initiative & Luck Points Side by Side --}}
        <div class="combat-badges-strip">
          {{!-- Initiative Button --}}
          <button type="button"
                  class="initiative-badge roll-btn"
                  data-action="rollInitiative"
                  title="Roll Initiative">
            <i class="fas fa-dice-d20 init-d20"></i>
            <div class="init-text-col">
              <span class="init-title">Initiative</span>
              <span class="init-score">{{#if (gte system.initiative.total 0)}}+{{/if}}{{system.initiative.total}}</span>
            </div>
          </button>

          {{!-- Luck Points (LP) Badge --}}
          <div class="lp-badge" title="Luck Points (LP)">
            <i class="fas fa-clover lp-icon"></i>
            <span class="lp-title">LP</span>
            <input type="number"
                   name="system.lp.value"
                   value="{{system.lp.value}}"
                   class="lp-input"
                   min="0" />
          </div>
        </div>

      </div>

      {{!-- Middle Section: Origins (Row 1) & Appearance + AR (Row 2) --}}
      <div class="header-meta-block">
        
        {{!-- Row 1: Level, Class & Origins --}}
        <div class="origins-row">
          {{!-- Level Chip --}}
          <div class="badge-chip level-chip" title="Character Level — Click arrow to Level Up / Manage HP">
            <span class="chip-label">Level</span>
            <input type="number"
                   name="system.level"
                   value="{{system.level}}"
                   class="chip-input level-input"
                   min="0" max="20" />
            <button type="button"
                    class="level-up-chip-btn"
                    data-action="openLevelUpDialog"
                    title="Level Up &amp; HP Calculator">
              <i class="fas fa-circle-arrow-up"></i>
            </button>
          </div>

          {{!-- Class --}}
          <button type="button" class="badge-chip class-chip" data-action="openTab" data-tab="talents" title="View Class &amp; Talents">
            <i class="fas fa-hat-wizard"></i>
            <span class="chip-value">{{classesDisplay}}</span>
          </button>

          {{!-- Origins (Lineage, Background, Profession) --}}
          {{#each originsList as |orig|}}
            {{#if orig.item}}
              <button type="button"
                      class="badge-chip origin-chip origin-filled"
                      data-action="viewDoc"
                      data-document-class="Item"
                      data-item-id="{{orig.item.id}}"
                      title="{{orig.label}}: {{orig.item.name}}">
                <span class="origin-type-label">{{orig.label}}:</span>
                <span class="origin-item-name">{{orig.item.name}}</span>
              </button>
            {{else}}
              <button type="button"
                      class="badge-chip origin-chip origin-empty"
                      data-action="createDoc"
                      data-document-class="Item"
                      data-type="{{orig.type}}"
                      title="Add {{orig.label}}">
                <i class="fas fa-plus"></i>
                <span>{{orig.label}}</span>
              </button>
            {{/if}}
          {{/each}}
        </div>

        {{!-- Row 2: Armor Rating (AR) directly under Level + Appearance & Size Dropdown --}}
        <div class="appearance-quick-row">
          {{!-- Armor Rating (AR) Chip styled like Level Chip --}}
          <div class="badge-chip ar-chip" title="Armor Rating (AR)">
            <span class="chip-label">AR</span>
            <input type="number"
                   name="system.defenses.ar"
                   value="{{system.defenses.ar}}"
                   class="chip-input ar-input"
                   min="0" />
          </div>

          {{!-- Size Dropdown --}}
          <div class="quick-field size-field">
            <span class="quick-label">Size:</span>
            <select name="system.size" class="quick-select size-select" title="Character Size">
              {{#each sizeOptions as |opt|}}
                <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
          </div>

          {{!-- Height --}}
          <div class="quick-field appearance-field">
            <span class="quick-label">Height:</span>
            <input type="text" name="system.appearance.height" value="{{system.appearance.height}}" class="quick-input" placeholder="—" />
          </div>

          {{!-- Weight --}}
          <div class="quick-field appearance-field">
            <span class="quick-label">Weight:</span>
            <input type="text" name="system.appearance.weight" value="{{system.appearance.weight}}" class="quick-input" placeholder="—" />
          </div>

          {{!-- Age --}}
          <div class="quick-field appearance-field">
            <span class="quick-label">Age:</span>
            <input type="text" name="system.appearance.age" value="{{system.appearance.age}}" class="quick-input" placeholder="—" />
          </div>
        </div>

      </div>

      {{!-- Bottom Row: HP, AP, SP Equal-Sized Clean HUD Boxes --}}
      <div class="resource-meters-panel">

        {{!-- 1. HP Card --}}
        <div class="meter-card hp-meter">
          <div class="meter-header">
            <div class="meter-label-group">
              <i class="fas fa-heart meter-icon hp-icon"></i>
              <span class="meter-title">HP</span>
              {{#if isBloodied}}
                <span class="bloodied-tag">Bloodied</span>
              {{/if}}
            </div>
            <div class="meter-inputs-group">
              <input type="number" name="system.hp.value" value="{{system.hp.value}}" class="meter-val-input" min="0" title="Current HP" />
              <span class="meter-divider">/</span>
              <input type="number" name="system.hp.max" value="{{system.hp.max}}" class="meter-max-input" min="0" title="Max HP" />
              <div class="shield-mini-box" title="Shield Points">
                <i class="fas fa-shield-alt"></i>
                <input type="number" name="system.hp.shield" value="{{system.hp.shield}}" class="shield-input" min="0" placeholder="0" />
              </div>
            </div>
          </div>

          <div class="meter-track hp-meter-track">
            <div class="meter-fill hp-bar-fill" data-meter-key="hp" style="width: {{hpPct}}%;"></div>
            {{#if (gt system.hp.shield 0)}}
              <div class="meter-fill shield-bar-fill" data-meter-key="shield" style="width: {{shieldPct}}%;" title="Shield Points: {{system.hp.shield}}"></div>
            {{/if}}
          </div>

          <div class="meter-sub-row hp-sub-row death-saves-bar">
            <span class="death-saves-label">
              <i class="fas fa-skull"></i>
              Death Points
            </span>
            <div class="death-inputs-wrap">
              <input type="number" name="system.death.value" value="{{system.death.value}}" class="death-val-input" min="0" data-tooltip="<strong>Current Death Points</strong>" data-tooltip-direction="UP" />
              <span class="meter-divider">/</span>
              <input type="number" name="system.death.max" value="{{system.death.max}}" class="death-max-input" min="0" data-tooltip="<strong>Max Death Points</strong>" data-tooltip-direction="UP" />
            </div>
          </div>
        </div>

        {{!-- 2. AP Card (With Critical Hit & Fail ranges in sub-row) --}}
        <div class="meter-card ap-meter">
          <div class="meter-header">
            <div class="meter-label-group">
              <i class="fas fa-bolt meter-icon ap-icon"></i>
              <span class="meter-title">AP</span>
            </div>
            <div class="meter-inputs-group">
              <div class="ap-stepper-wrap" data-tooltip="<strong>Current Action Points</strong><br/><span style='font-size:11px;'>Use &minus; and + or type directly</span>" data-tooltip-direction="UP">
                <button type="button" class="ap-step-btn ap-step-minus" data-action="adjustAp" data-delta="-1" title="Subtract 1 AP">
                  <i class="fas fa-minus"></i>
                </button>
                <input type="number" name="system.ap.value" value="{{system.ap.value}}" class="meter-val-input ap-val-input" min="0" />
                <button type="button" class="ap-step-btn ap-step-plus" data-action="adjustAp" data-delta="1" title="Add 1 AP">
                  <i class="fas fa-plus"></i>
                </button>
              </div>
              <span class="meter-divider">/</span>
              <input type="number" name="system.ap.max" value="{{system.ap.max}}" class="meter-max-input" min="0" data-tooltip="<strong>Max Action Points</strong>" data-tooltip-direction="UP" />
              <div class="sap-mini-box" data-tooltip="<strong>Special Action Points (SAP)</strong><br/><span style='font-size:11px;'>Bonus AP that resets at start of turn</span>" data-tooltip-direction="UP">
                <span class="sap-label">SAP</span>
                <input type="number" name="system.ap.special" value="{{system.ap.special}}" class="sap-input" min="0" placeholder="0" />
              </div>
            </div>
          </div>

          <div class="meter-track ap-meter-track">
            <div class="meter-fill ap-bar-fill" data-meter-key="ap" style="width: {{apPct}}%;"></div>
            {{#if (gt system.ap.special 0)}}
              <div class="meter-fill sap-bar-fill" data-meter-key="sap" style="width: {{sapPct}}%;" data-tooltip="<strong>Special Action Points: {{system.ap.special}}</strong>" data-tooltip-direction="UP"></div>
            {{/if}}
          </div>

          <div class="meter-sub-row ap-sub-row">
            <span class="meter-sub-label crit-range-sub-label">
              <i class="fas fa-crosshairs"></i>
              Crit Range
            </span>
            <div class="crit-ranges-mini">
              {{#if hasNegativeLuck}}
                <div class="crit-chip hit-chip no-crit" 
                     data-tooltip="<strong>Critical Hit: None</strong><br/><span style='font-size:11px; color:#f87171;'>Negative LUCK ({{luckScore}}): You can never critically hit, and you subtract {{luckPenalty}} from every d20 roll.</span>" 
                     data-tooltip-direction="UP"
                     style="border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.1);">
                  <i class="fas fa-ban" style="color:#f87171;"></i>
                  <span class="crit-lbl" style="color:#f87171;">CRIT</span>
                  <span class="crit-num" style="color:#f87171;">None</span>
                </div>
              {{else}}
                <div class="crit-chip hit-chip" data-tooltip="<strong>Critical Hit Range</strong><br/><span style='font-size:11px;'>Natural {{critHit}}+ lands a Critical Hit</span>" data-tooltip-direction="UP">
                  <i class="fas fa-bullseye"></i>
                  <span class="crit-lbl">CRIT</span>
                  <span class="crit-num">{{critHit}}+</span>
                </div>
              {{/if}}
              <div class="crit-chip fail-chip" data-tooltip="<strong>Critical Fail Range</strong><br/><span style='font-size:11px;'>Natural {{critFail}} or lower triggers a Critical Fail</span>" data-tooltip-direction="UP">
                <i class="fas fa-skull-crossbones"></i>
                <span class="crit-lbl">FAIL</span>
                <span class="crit-num">{{critFail}}&minus;</span>
              </div>
            </div>
          </div>
        </div>

        {{!-- 3. SP Card (With Magic Power Levels in sub-row) - Dissolves away for non-spellcasters --}}
        <div class="meter-card sp-meter {{#if hasSpellcasting}}has-sp{{else}}no-sp{{/if}}">
          <div class="meter-header">
            <div class="meter-label-group">
              <i class="fas fa-hat-wizard meter-icon sp-icon"></i>
              <span class="meter-title">SP</span>
            </div>
            <div class="meter-inputs-group">
              <input type="number" name="system.sp.value" value="{{system.sp.value}}" class="meter-val-input" min="0" data-tooltip="<strong>Current Spell Points</strong>" data-tooltip-direction="UP" />
              <span class="meter-divider">/</span>
              <input type="number" name="system.sp.max" value="{{system.sp.max}}" class="meter-max-input" min="0" data-tooltip="<strong>Max Spell Points</strong>" data-tooltip-direction="UP" />
            </div>
          </div>

          <div class="meter-track">
            <div class="meter-fill sp-bar-fill" data-meter-key="sp" style="width: {{spPct}}%;"></div>
          </div>

          <div class="meter-sub-row sp-sub-row">
            <span class="meter-sub-label power-level-sub-label">
              <i class="fas fa-wand-magic-sparkles"></i>
              Power Level
            </span>
            <div class="power-levels-mini-strip">
              {{#if hasMagicPower}}
                {{#each magicPowerPills as |p|}}
                  <div class="power-pill power-num-chip {{p.key}}" 
                       style="--pill-color: {{p.color}}; --pill-bg: {{p.bg}}; --pill-border: {{p.border}};" 
                       data-tooltip="<strong>{{p.label}}</strong>: {{p.value}}"
                       data-tooltip-direction="UP">
                    <span class="power-pill-val">{{p.value}}</span>
                  </div>
                {{/each}}
              {{else}}
                <div class="power-pill power-num-chip zero-val" 
                     data-tooltip="<strong>Power Level</strong>: 0"
                     data-tooltip-direction="UP">
                  <span class="power-pill-val">0</span>
                </div>
              {{/if}}
            </div>
          </div>
        </div>

        {{!-- 4. Fear Meter Card (Homebrew / Optional Rules) --}}
        {{#if enableFear}}
          <div class="meter-card fear-meter {{#if isFearExceeded}}fear-exceeded{{/if}}">
            <div class="meter-header">
              <div class="meter-label-group">
                <i class="fas fa-ghost meter-icon fear-icon"></i>
                <span class="meter-title">Fear</span>
                {{#if isFearExceeded}}
                  <span class="fear-exceeded-tag" data-tooltip="<strong>Exceeded Fear Threshold!</strong><br/><span style='font-size:11px; color:#fca5a5;'>You must resolve excess fear before you can Take a Rest, or you gain Fatigue.</span>" data-tooltip-direction="UP">Exceeded</span>
                {{/if}}
              </div>
              <div class="meter-inputs-group">
                <input type="number"
                       name="flags.mythcraft-essence-sheet.fear"
                       value="{{fearValue}}"
                       class="meter-val-input fear-val-input"
                       min="0"
                       data-tooltip="<strong>Current Fear</strong><br/><span style='font-size:11px;'>+1 on failed SAN checks, horrific events, or resting outside a Haven.</span>"
                       data-tooltip-direction="UP" />
                <span class="meter-divider">/</span>
                <span class="fear-threshold-display"
                      data-tooltip="<strong>Fear Threshold: {{fearThreshold}}</strong><br/><span style='font-size:11px;'>Calculated from Sanity: 1 + ⌊SAN / 2⌋ (negative SAN subtracts).</span>"
                      data-tooltip-direction="UP">{{displayFearThreshold}}</span>
              </div>
            </div>

            <div class="meter-track fear-meter-track">
              <div class="meter-fill fear-bar-fill" style="width: {{fearPct}}%;"></div>
            </div>

            <div class="meter-sub-row fear-sub-row">
              <span class="meter-sub-label fear-sub-label">
                <i class="fas fa-shield-halved"></i>
                Threshold
              </span>
              <span class="fear-status-text">
                {{#if isFearExceeded}}
                  <strong style="color: #f87171;">Must resolve before Rest</strong>
                {{else}}
                  <span>Max Capacity: {{fearThreshold}}</span>
                {{/if}}
              </span>
            </div>
          </div>
        {{/if}}

      </div>

    </div>

  </div>

  {{!-- ── 4 Dedicated Quick-Access Side Tabs (Branching off the right edge) ── --}}
  <aside class="essence-side-tabs-bar" aria-label="Quick Access Side Tabs">
    
    {{!-- 1. Storage / Backpack Tab --}}
    <button type="button" 
            class="side-bookmark-tab storage-tab {{#if (eq sideDrawer.activeTab 'storage')}}active{{/if}}"
            data-action="toggleSideDrawer"
            data-drawer-tab="storage"
            data-tooltip="<strong>Storage Containers</strong><br>{{sideDrawer.storage.containerCount}} containers • {{sideDrawer.storage.totalItems}} items stored"
            data-tooltip-direction="LEFT">
      <i class="fas fa-backpack tab-icon"></i>
      <span class="side-tab-badge">{{sideDrawer.storage.totalItems}}</span>
    </button>

    {{!-- 2. Clothes Tab --}}
    <button type="button" 
            class="side-bookmark-tab clothes-tab {{#if (eq sideDrawer.activeTab 'clothes')}}active{{/if}}"
            data-action="toggleSideDrawer"
            data-drawer-tab="clothes"
            data-tooltip="<strong>Worn Clothing</strong><br>{{sideDrawer.clothes.wornCount}} worn • {{sideDrawer.clothes.totalCount}} available"
            data-tooltip-direction="LEFT">
      <i class="fas fa-shirt tab-icon"></i>
      <span class="side-tab-badge">{{sideDrawer.clothes.wornCount}}</span>
    </button>

    {{!-- 3. Armor Tab --}}
    <button type="button" 
            class="side-bookmark-tab armor-tab {{#if (eq sideDrawer.activeTab 'armor')}}active{{/if}}"
            data-action="toggleSideDrawer"
            data-drawer-tab="armor"
            data-tooltip="<strong>Donned Armor</strong><br>{{sideDrawer.armor.count}} equipped • AR {{sideDrawer.armor.ar}}"
            data-tooltip-direction="LEFT">
      <i class="fas fa-shield-halved tab-icon"></i>
      <span class="side-tab-badge">{{sideDrawer.armor.count}}</span>
    </button>

    {{!-- 4. Equipped Weapons Tab --}}
    <button type="button" 
            class="side-bookmark-tab weapons-tab {{#if (eq sideDrawer.activeTab 'weapons')}}active{{/if}}"
            data-action="toggleSideDrawer"
            data-drawer-tab="weapons"
            data-tooltip="<strong>Equipped Weapons</strong><br>{{sideDrawer.weapons.count}} equipped"
            data-tooltip-direction="LEFT">
      <i class="fas fa-crosshairs tab-icon"></i>
      <span class="side-tab-badge">{{sideDrawer.weapons.count}}</span>
    </button>

  </aside>

  {{!-- ── Quick Access Side Drawer Flyout Panel ── --}}
  {{#if sideDrawer.activeTab}}
    <div class="essence-side-drawer-flyout" data-active-tab="{{sideDrawer.activeTab}}">
      
      {{!-- Drawer Header --}}
      <div class="drawer-header">
        <div class="drawer-title">
          {{#if (eq sideDrawer.activeTab 'storage')}}
            <i class="fas fa-backpack drawer-title-icon"></i>
            <span>STORAGE CONTAINERS</span>
          {{else if (eq sideDrawer.activeTab 'clothes')}}
            <i class="fas fa-shirt drawer-title-icon"></i>
            <span>WORN CLOTHING</span>
          {{else if (eq sideDrawer.activeTab 'armor')}}
            <i class="fas fa-shield-halved drawer-title-icon"></i>
            <span>DONNED ARMOR</span>
          {{else if (eq sideDrawer.activeTab 'weapons')}}
            <i class="fas fa-crosshairs drawer-title-icon"></i>
            <span>EQUIPPED WEAPONS</span>
          {{/if}}
        </div>
        <button type="button" class="drawer-close-btn" data-action="closeSideDrawer" title="Close Drawer">
          <i class="fas fa-times"></i>
        </button>
      </div>

      {{!-- Drawer Body Content --}}
      <div class="drawer-body-scroll">
        
        {{!-- STORAGE TAB CONTENT --}}
        {{#if (eq sideDrawer.activeTab 'storage')}}
          {{#if sideDrawer.storage.containers.length}}
            <div class="drawer-containers-list">
              {{#each sideDrawer.storage.containers as |c|}}
                <div class="drawer-container-card container-drop-zone" data-container-id="{{c.id}}">
                  <div class="drawer-container-card-header">
                    <img src="{{c.img}}" alt="{{c.name}}" class="drawer-container-icon" />
                    <span class="drawer-container-name">{{c.name}}</span>
                    <span class="drawer-container-badge">{{c.contentsCount}} {{#if (eq c.contentsCount 1)}}item{{else}}items{{/if}}</span>
                  </div>
                  {{#if c.contents.length}}
                    <ul class="drawer-items-list">
                      {{#each c.contents as |ci|}}
                        <li class="drawer-item-row draggable" data-item-id="{{ci.id}}">
                          <img src="{{ci.img}}" alt="{{ci.name}}" class="drawer-item-img" data-action="viewDoc" data-item-id="{{ci.id}}" />
                          <span class="drawer-item-name" data-action="viewDoc" data-item-id="{{ci.id}}">{{ci.name}}</span>
                          {{#if ci.quantity}}
                            <span class="drawer-item-qty">×{{ci.quantity}}</span>
                          {{/if}}
                          <button type="button" 
                                  class="drawer-item-unpack-btn" 
                                  data-action="removeFromContainer" 
                                  data-item-id="{{ci.id}}" 
                                  title="Unpack Item (Costs 1 AP in Combat)">
                            <i class="fas fa-arrow-up-from-bracket"></i>
                          </button>
                        </li>
                      {{/each}}
                    </ul>
                  {{else}}
                    <p class="drawer-empty-hint">Drag &amp; drop items here to store</p>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="drawer-empty-msg">No storage containers found in inventory.</p>
          {{/if}}

        {{!-- CLOTHES TAB CONTENT --}}
        {{else if (eq sideDrawer.activeTab 'clothes')}}
          {{#if sideDrawer.clothes.items.length}}
            <ul class="drawer-items-list">
              {{#each sideDrawer.clothes.items as |cl|}}
                <li class="drawer-item-row {{#if cl.isWorn}}worn-item-row{{/if}}" data-item-id="{{cl.id}}">
                  <img src="{{cl.img}}" alt="{{cl.name}}" class="drawer-item-img" data-action="viewDoc" data-item-id="{{cl.id}}" />
                  <div class="drawer-item-info">
                    <span class="drawer-item-name" data-action="viewDoc" data-item-id="{{cl.id}}">{{cl.name}}</span>
                    {{#if cl.isWorn}}
                      <span class="worn-status-tag"><i class="fas fa-check"></i> Worn</span>
                    {{/if}}
                  </div>
                  <button type="button" 
                          class="drawer-action-toggle-btn {{#if cl.isWorn}}active-wear{{/if}}" 
                          data-action="toggleWearClothes" 
                          data-item-id="{{cl.id}}" 
                          title="{{#if cl.isWorn}}Take Off Clothes{{else}}Wear Clothes{{/if}}">
                    <i class="fas {{#if cl.isWorn}}fa-shirt{{else}}fa-vest{{/if}}"></i>
                    <span>{{#if cl.isWorn}}Remove{{else}}Wear{{/if}}</span>
                  </button>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="drawer-empty-msg">No clothing items found in inventory.</p>
          {{/if}}

        {{!-- ARMOR TAB CONTENT --}}
        {{else if (eq sideDrawer.activeTab 'armor')}}
          <div class="drawer-dual-hands-grid">

            {{!-- BODY ARMOR SLOT --}}
            <div class="drawer-hand-column hand-column-body-armor">
              <div class="drawer-hand-header">
                <i class="fas fa-vest"></i>
                <span>Body Armor</span>
              </div>

              {{#if sideDrawer.armor.bodyArmor}}
                <div class="drawer-hand-card filled-hand-card" data-item-id="{{sideDrawer.armor.bodyArmor.id}}">
                  <div class="hand-card-main-info">
                    <img src="{{sideDrawer.armor.bodyArmor.img}}" alt="{{sideDrawer.armor.bodyArmor.name}}" class="drawer-item-img" data-action="viewDoc" data-item-id="{{sideDrawer.armor.bodyArmor.id}}" />
                    <div class="drawer-item-info">
                      <span class="drawer-item-name" data-action="viewDoc" data-item-id="{{sideDrawer.armor.bodyArmor.id}}">{{sideDrawer.armor.bodyArmor.name}}</span>
                      <div class="drawer-weapon-mini-stats">
                        <span class="mini-hand-tag">Armor</span>
                        <span class="mini-ar-tag">AR {{sideDrawer.armor.bodyArmor.ar}}</span>
                      </div>
                    </div>
                  </div>
                  <div class="drawer-weapon-actions">
                    <button type="button" 
                            class="drawer-action-toggle-btn doff-btn" 
                            data-action="toggleDonArmor" 
                            data-item-id="{{sideDrawer.armor.bodyArmor.id}}" 
                            title="Doff Armor">
                      <i class="fas fa-shield-xmark"></i>
                      <span>Doff</span>
                    </button>
                  </div>
                </div>
              {{else}}
                {{!-- Empty Body Armor Slot --}}
                <button type="button" 
                        class="drawer-empty-hand-slot" 
                        data-action="openArmorPicker" 
                        data-armor-type="body" 
                        title="Click to don body armor">
                  <i class="fas fa-plus"></i>
                  <span>Don Body Armor</span>
                </button>
              {{/if}}
            </div>

            {{!-- SHIELD SLOT --}}
            <div class="drawer-hand-column hand-column-shield">
              <div class="drawer-hand-header">
                <i class="fas fa-shield"></i>
                <span>Shield</span>
              </div>

              {{#if sideDrawer.armor.shield}}
                <div class="drawer-hand-card filled-hand-card" data-item-id="{{sideDrawer.armor.shield.id}}">
                  <div class="hand-card-main-info">
                    <img src="{{sideDrawer.armor.shield.img}}" alt="{{sideDrawer.armor.shield.name}}" class="drawer-item-img" data-action="viewDoc" data-item-id="{{sideDrawer.armor.shield.id}}" />
                    <div class="drawer-item-info">
                      <span class="drawer-item-name" data-action="viewDoc" data-item-id="{{sideDrawer.armor.shield.id}}">{{sideDrawer.armor.shield.name}}</span>
                      <div class="drawer-weapon-mini-stats">
                        <span class="mini-hand-tag">Shield</span>
                        <span class="mini-ar-tag">+{{sideDrawer.armor.shield.shieldArBonus}} AR</span>
                      </div>
                    </div>
                  </div>
                  <div class="drawer-weapon-actions">
                    <button type="button" 
                            class="drawer-action-toggle-btn stow-btn" 
                            data-action="toggleEquipShield" 
                            data-item-id="{{sideDrawer.armor.shield.id}}" 
                            title="Stow Shield">
                      <i class="fas fa-hand-holding-box"></i>
                      <span>Stow</span>
                    </button>
                  </div>
                </div>
              {{else}}
                {{!-- Empty Shield Slot --}}
                <button type="button" 
                        class="drawer-empty-hand-slot" 
                        data-action="openArmorPicker" 
                        data-armor-type="shield" 
                        title="Click to equip shield">
                  <i class="fas fa-plus"></i>
                  <span>Equip Shield</span>
                </button>
              {{/if}}
            </div>

          </div>

        {{!-- WEAPONS TAB CONTENT (Side-by-Side Dual-Hand Layout) --}}
        {{else if (eq sideDrawer.activeTab 'weapons')}}
          <div class="drawer-dual-hands-grid">

            {{!-- LEFT HAND (Off Hand) --}}
            <div class="drawer-hand-column hand-column-left">
              <div class="drawer-hand-header">
                <i class="fas fa-hand-back-fist"></i>
                <span>Left Hand</span>
              </div>

              {{#if sideDrawer.weapons.isTwoHanded}}
                {{!-- 2H Weapon Spans / Occupies Left Hand --}}
                <div class="drawer-hand-card two-handed-grip-card" data-item-id="{{sideDrawer.weapons.twoHanded.id}}">
                  <div class="two-handed-badge-label">
                    {{#if sideDrawer.weapons.twoHanded.isHandAndHalf}}
                      <button type="button" 
                              class="mini-hand-tag hand-and-a-half-drawer-toggle" 
                              data-action="toggleHandAndHalfMode" 
                              data-item-id="{{sideDrawer.weapons.twoHanded.id}}" 
                              title="Hand-and-a-Half Weapon (Gripped 2H). Click to switch to 1H.">
                        <i class="fas fa-hands"></i> 1.5H (2H)
                      </button>
                    {{else}}
                      <i class="fas fa-hands"></i> 2H Grip
                    {{/if}}
                  </div>
                  <span class="two-handed-item-name">{{sideDrawer.weapons.twoHanded.name}}</span>
                </div>
              {{else if sideDrawer.weapons.offHand}}
                <div class="drawer-hand-card filled-hand-card" data-item-id="{{sideDrawer.weapons.offHand.id}}">
                  <div class="hand-card-main-info">
                    <img src="{{sideDrawer.weapons.offHand.img}}" alt="{{sideDrawer.weapons.offHand.name}}" class="drawer-item-img" data-action="viewDoc" data-item-id="{{sideDrawer.weapons.offHand.id}}" />
                    <div class="drawer-item-info">
                      <span class="drawer-item-name" data-action="viewDoc" data-item-id="{{sideDrawer.weapons.offHand.id}}">{{sideDrawer.weapons.offHand.name}}</span>
                      <div class="drawer-weapon-mini-stats">
                        {{#if sideDrawer.weapons.offHand.isShield}}
                          <span class="mini-hand-tag">Shield</span>
                          <span class="mini-ar-tag">+{{sideDrawer.weapons.offHand.shieldArBonus}} AR</span>
                        {{else if sideDrawer.weapons.offHand.isHandAndHalf}}
                          <button type="button" 
                                  class="mini-hand-tag hand-and-a-half-drawer-toggle" 
                                  data-action="toggleHandAndHalfMode" 
                                  data-item-id="{{sideDrawer.weapons.offHand.id}}" 
                                  title="Hand-and-a-Half Weapon (Gripped {{sideDrawer.weapons.offHand.effectiveGrip}}). Click to toggle 1H / 2H.">
                            {{sideDrawer.weapons.offHand.handLabel}}
                          </button>
                          <span class="mini-ap-tag">{{sideDrawer.weapons.offHand.apc}} AP</span>
                        {{else}}
                          <span class="mini-hand-tag">{{sideDrawer.weapons.offHand.handLabel}}</span>
                          <span class="mini-ap-tag">{{sideDrawer.weapons.offHand.apc}} AP</span>
                        {{/if}}
                      </div>
                    </div>
                  </div>
                  <div class="drawer-weapon-actions">
                    {{#if sideDrawer.weapons.offHand.isShield}}
                      <button type="button" 
                              class="drawer-action-toggle-btn stow-btn" 
                              data-action="toggleEquipShield" 
                              data-item-id="{{sideDrawer.weapons.offHand.id}}" 
                              title="Stow Shield">
                        <i class="fas fa-hand-holding-box"></i>
                      </button>
                    {{else}}
                      <button type="button" 
                              class="drawer-roll-atk-btn" 
                              data-action="rollAttack" 
                              data-item-id="{{sideDrawer.weapons.offHand.id}}" 
                              title="Roll Attack">
                        <i class="fas fa-crosshairs"></i>
                      </button>
                      <button type="button" 
                              class="drawer-roll-dmg-btn" 
                              data-action="rollDamage" 
                              data-item-id="{{sideDrawer.weapons.offHand.id}}" 
                              title="Roll Damage">
                        <i class="fas fa-burst"></i>
                      </button>
                      <button type="button" 
                              class="drawer-action-toggle-btn stow-btn" 
                              data-action="toggleEquipWeapon" 
                              data-item-id="{{sideDrawer.weapons.offHand.id}}" 
                              title="Stow Weapon">
                        <i class="fas fa-hand-holding-box"></i>
                      </button>
                    {{/if}}
                  </div>
                </div>
              {{else}}
                {{!-- Empty Left Hand Slot --}}
                <button type="button" 
                        class="drawer-empty-hand-slot" 
                        data-action="openHandEquipPicker" 
                        data-hand="off" 
                        title="Click to equip weapon/shield into Left Hand">
                  <i class="fas fa-plus"></i>
                  <span>Equip Left Hand</span>
                </button>
              {{/if}}
            </div>

            {{!-- RIGHT HAND (Main Hand) --}}
            <div class="drawer-hand-column hand-column-right">
              <div class="drawer-hand-header">
                <i class="fas fa-hand-fist"></i>
                <span>Right Hand</span>
              </div>

              {{#if sideDrawer.weapons.mainHand}}
                <div class="drawer-hand-card filled-hand-card {{#if sideDrawer.weapons.isTwoHanded}}two-handed-main-card{{/if}}" data-item-id="{{sideDrawer.weapons.mainHand.id}}">
                  <div class="hand-card-main-info">
                    <img src="{{sideDrawer.weapons.mainHand.img}}" alt="{{sideDrawer.weapons.mainHand.name}}" class="drawer-item-img" data-action="viewDoc" data-item-id="{{sideDrawer.weapons.mainHand.id}}" />
                    <div class="drawer-item-info">
                      <span class="drawer-item-name" data-action="viewDoc" data-item-id="{{sideDrawer.weapons.mainHand.id}}">{{sideDrawer.weapons.mainHand.name}}</span>
                      <div class="drawer-weapon-mini-stats">
                        {{#if sideDrawer.weapons.mainHand.isShield}}
                          <span class="mini-hand-tag">Shield</span>
                          <span class="mini-ar-tag">+{{sideDrawer.weapons.mainHand.shieldArBonus}} AR</span>
                        {{else if sideDrawer.weapons.mainHand.isHandAndHalf}}
                          <button type="button" 
                                  class="mini-hand-tag hand-and-a-half-drawer-toggle" 
                                  data-action="toggleHandAndHalfMode" 
                                  data-item-id="{{sideDrawer.weapons.mainHand.id}}" 
                                  title="Hand-and-a-Half Weapon (Gripped {{sideDrawer.weapons.mainHand.effectiveGrip}}). Click to toggle 1H / 2H.">
                            {{sideDrawer.weapons.mainHand.handLabel}}
                          </button>
                          <span class="mini-ap-tag">{{sideDrawer.weapons.mainHand.apc}} AP</span>
                        {{else}}
                          <span class="mini-hand-tag">{{sideDrawer.weapons.mainHand.handLabel}}</span>
                          <span class="mini-ap-tag">{{sideDrawer.weapons.mainHand.apc}} AP</span>
                        {{/if}}
                      </div>
                    </div>
                  </div>
                  <div class="drawer-weapon-actions">
                    {{#if sideDrawer.weapons.mainHand.isShield}}
                      <button type="button" 
                              class="drawer-action-toggle-btn stow-btn" 
                              data-action="toggleEquipShield" 
                              data-item-id="{{sideDrawer.weapons.mainHand.id}}" 
                              title="Stow Shield">
                        <i class="fas fa-hand-holding-box"></i>
                      </button>
                    {{else}}
                      <button type="button" 
                              class="drawer-roll-atk-btn" 
                              data-action="rollAttack" 
                              data-item-id="{{sideDrawer.weapons.mainHand.id}}" 
                              title="Roll Attack">
                        <i class="fas fa-crosshairs"></i>
                      </button>
                      <button type="button" 
                              class="drawer-roll-dmg-btn" 
                              data-action="rollDamage" 
                              data-item-id="{{sideDrawer.weapons.mainHand.id}}" 
                              title="Roll Damage">
                        <i class="fas fa-burst"></i>
                      </button>
                      <button type="button" 
                              class="drawer-action-toggle-btn stow-btn" 
                              data-action="toggleEquipWeapon" 
                              data-item-id="{{sideDrawer.weapons.mainHand.id}}" 
                              title="Stow Weapon">
                        <i class="fas fa-hand-holding-box"></i>
                      </button>
                    {{/if}}
                  </div>
                </div>
              {{else}}
                {{!-- Empty Right Hand Slot --}}
                <button type="button" 
                        class="drawer-empty-hand-slot" 
                        data-action="openHandEquipPicker" 
                        data-hand="main" 
                        title="Click to equip weapon into Right Hand">
                  <i class="fas fa-plus"></i>
                  <span>Equip Right Hand</span>
                </button>
              {{/if}}
            </div>

          </div>

        {{/if}}

      </div>
    </div>
  {{/if}}

</header>
