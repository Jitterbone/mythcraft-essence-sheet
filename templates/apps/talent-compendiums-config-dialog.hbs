<div class="talent-compendiums-dialog-content">

  {{!-- ── 1. Header Overview Card ───────────────────────────────── --}}
  <div class="dialog-header-card">
    <div class="header-icon-box">
      <i class="fas fa-folder-tree"></i>
    </div>
    <div class="header-text-box">
      <h2 class="dialog-title">Custom Compendium Content</h2>
      <p class="dialog-subtitle">
        Register external and homebrew Item compendiums for Lineages, Starting Features, Milestone Features, Classes, Subclasses, Specializations, and Magic.
      </p>
    </div>
  </div>

  {{!-- ── Tag System Quick Reference ─────────────────────────────── --}}
  <div class="dialog-info-card" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 6px; padding: 10px 14px; margin-bottom: 12px;">
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px; color:#38bdf8; font-weight:700; font-size:12px;">
      <i class="fas fa-tags"></i> Direct Item Tag Quick Reference
    </div>
    <p style="font-size:11px; color:#cbd5e1; margin:0 0 6px 0; line-height:1.4;">
      You can organize content either by <strong>Compendium Folders</strong> or by adding explicit tags to your homebrew items (in <code>system.tags</code> or item properties):
    </p>
    <div style="display:flex; flex-wrap:wrap; gap:8px; font-size:10.5px;">
      <span style="background:rgba(30, 41, 59, 0.9); border:1px solid #475569; padding:2px 8px; border-radius:4px; color:#93c5fd;"><code>class: &lt;Class&gt;</code></span>
      <span style="background:rgba(30, 41, 59, 0.9); border:1px solid #475569; padding:2px 8px; border-radius:4px; color:#93c5fd;"><code>track: &lt;Track&gt;</code></span>
      <span style="background:rgba(30, 41, 59, 0.9); border:1px solid #475569; padding:2px 8px; border-radius:4px; color:#a7f3d0;"><code>ancestry: &lt;Name&gt;</code></span>
      <span style="background:rgba(30, 41, 59, 0.9); border:1px solid #475569; padding:2px 8px; border-radius:4px; color:#a7f3d0;"><code>sublineage: &lt;Name&gt;</code></span>
      <span style="background:rgba(30, 41, 59, 0.9); border:1px solid #475569; padding:2px 8px; border-radius:4px; color:#fde68a;"><code>feature: starting</code> (auto-granted)</span>
      <span style="background:rgba(30, 41, 59, 0.9); border:1px solid #475569; padding:2px 8px; border-radius:4px; color:#fde68a;"><code>feature: all</code> (milestone pool)</span>
      <span style="background:rgba(30, 41, 59, 0.9); border:1px solid #475569; padding:2px 8px; border-radius:4px; color:#f472b6;"><code>entry: true</code> (entry talent)</span>
    </div>
  </div>

  {{!-- ── 2. Compendiums List Container ─────────────────────────── --}}
  <div class="dialog-section-card">
    <div class="section-title-row">
      <div class="title-left">
        <i class="fas fa-books"></i>
        <span class="section-title">Configured Compendium Sources ({{totalConfigured}})</span>
      </div>
      <button type="button" class="add-comp-btn" data-action="addCustomCompendium">
        <i class="fas fa-plus"></i> Add Compendium
      </button>
    </div>

    <p class="section-desc">
      Select an Item compendium from the dropdown or enter its package ID (e.g. <code>world.my-talents</code>). Choose its content type and how items are acquired or displayed.
    </p>

    {{#if hasCustomCompendiums}}
      <div class="compendiums-list">
        {{#each customCompendiums as |comp|}}
          <div class="compendium-config-card" data-index="{{comp.index}}">
            
            <div class="card-row-main">
              
              {{!-- Pack Selection --}}
              <div class="field-group pack-group">
                <label class="field-lbl"><i class="fas fa-box-archive"></i> Compendium Pack</label>
                <select name="compendiums.{{comp.index}}.pack" class="comp-select">
                  <option value="">-- Select Compendium --</option>
                  {{#each ../availablePacks as |pack|}}
                    <option value="{{pack.id}}" {{#if (eq comp.pack pack.id)}}selected{{/if}}>
                      {{pack.title}} ({{pack.id}})
                    </option>
                  {{/each}}
                </select>
              </div>

              {{!-- Category Selection --}}
              <div class="field-group cat-group">
                <label class="field-lbl"><i class="fas fa-layer-group"></i> Category</label>
                <select name="compendiums.{{comp.index}}.category" class="cat-select">
                  {{#each comp.categoryOptions as |cat|}}
                    <option value="{{cat.key}}" {{#if cat.selected}}selected{{/if}}>
                      {{cat.label}}
                    </option>
                  {{/each}}
                </select>
              </div>

              {{!-- Acquisition Mode Selection --}}
              <div class="field-group cat-group">
                <label class="field-lbl"><i class="fas fa-hand-holding-magic"></i> Acquisition Mode</label>
                <select name="compendiums.{{comp.index}}.acquisition" class="acq-select">
                  {{#each comp.acquisitionOptions as |acq|}}
                    <option value="{{acq.key}}" {{#if acq.selected}}selected{{/if}}>
                      {{acq.label}}
                    </option>
                  {{/each}}
                </select>
              </div>

              {{!-- Delete Button --}}
              <button type="button" 
                      class="delete-comp-btn" 
                      data-action="deleteCustomCompendium" 
                      data-index="{{comp.index}}"
                      title="Remove Compendium">
                <i class="fas fa-trash"></i>
              </button>
            </div>

            <div class="card-row-details">
              {{!-- Parent Class / Lineage / Stack / Discipline Name --}}
              <div class="field-group parent-group">
                <label class="field-lbl">
                  <i class="fas fa-sitemap"></i>
                  Parent Name (Class / Lineage / Stack / Discipline)
                </label>
                <input type="text"
                       name="compendiums.{{comp.index}}.parentName"
                       value="{{comp.parentName}}"
                       placeholder="e.g. Elf, Dwarf, Warrior, Combat Stack, Arcane..."
                       title="Assigns this compendium's items under a parent lineage, class, specialization stack, or magic discipline" />
              </div>

              {{!-- Optional Track / Sublineage Name Override --}}
              <div class="field-group track-group">
                <label class="field-lbl">
                  <i class="fas fa-route"></i>
                  Custom Track / Sublineage Name (Optional)
                </label>
                <input type="text"
                       name="compendiums.{{comp.index}}.trackName"
                       value="{{comp.trackName}}"
                       placeholder="Auto-detect from compendium folders"
                       title="Optional: Force a specific track or sublineage title instead of reading folder names" />
              </div>
            </div>

            {{#if comp.hasFolders}}
              <div class="detected-folders-panel">
                <div class="folders-header">
                  <i class="fas fa-folder-tree"></i>
                  <span>Detected Compendium Folders ({{comp.folderCount}}):</span>
                </div>
                <div class="folders-tags-list">
                  {{#each comp.detectedFolders as |folderName|}}
                    <span class="folder-chip" title="Automatically mapped according to folder hierarchy"><i class="fas fa-folder"></i> {{folderName}}</span>
                  {{/each}}
                </div>
              </div>
            {{/if}}

          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-compendiums-state">
        <i class="fas fa-folder-open"></i>
        <h3>No Custom Compendiums Configured</h3>
        <p>Click <strong>Add Compendium</strong> above to register homebrew or third-party content packs for ancestries, classes, and talents.</p>
      </div>
    {{/if}}

  </div>

  {{!-- ── 3. Footer Action Strip ───────────────────────────────── --}}
  <footer class="dialog-footer">
    <button type="submit" class="submit-btn">
      <i class="fas fa-save"></i> Save &amp; Apply Changes
    </button>
  </footer>

</div>
