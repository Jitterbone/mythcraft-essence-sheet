                            <span class="encouraged-pill"><i class="fas fa-star"></i> Background Synergy: +{{parsedBackground.encouragedProfessions.bonusValue}} {{parsedBackground.encouragedProfessions.bonusSkill}}</span>
                          {{/if}}
                        </div>

