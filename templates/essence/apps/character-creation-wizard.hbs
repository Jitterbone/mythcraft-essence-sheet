                            <div class="choice-skills-wrap">
                              {{#each parsedProfession.choiceSkills.options as |opt|}}
                                <label class="choice-skill-toggle {{#if (includes ../data.selectedProfessionSkills opt)}}checked{{/if}}">
                                  <input type="checkbox" data-action="toggleProfessionSkill" data-skill="{{opt}}"
                                         {{#if (includes ../data.selectedProfessionSkills opt)}}checked{{/if}} />
                                  <i class="fas {{#if (includes ../data.selectedProfessionSkills opt)}}fa-check-square{{else}}fa-square{{/if}}"></i>
                                  <span>+{{../parsedProfession.choiceSkills.value}} {{opt}}</span>
                                </label>
                              {{/each}}
                            </div>
                          {{/if}}
                        </div>

                        {{#if parsedProfession.startingGear.length}}
