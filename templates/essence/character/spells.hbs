{{!-- ============================================================
     MythCraft Essence Sheet — Spells Tab
     Context: system, systemSource, magicLevels[], spells[],
              isEditable, editable
     ============================================================ --}}
<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="spells">

  {{!-- ── Power Levels ─────────────────────────────────────── --}}
  <div class="magic-levels-section">
    <div class="magic-levels-header-bar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
      <h3 class="section-header" style="margin: 0;">
        <i class="fas fa-hat-wizard"></i>
        <span>Power Levels</span>
      </h3>
      <div class="magic-attribute-selector" style="display: flex; align-items: center; gap: 8px;">
        <label for="magic-attr-select" style="font-size: 11px; font-weight: 700; color: #a8d5e2; text-transform: uppercase;"><i class="fas fa-wand-magic-sparkles"></i> Magic Attribute:</label>
        <select id="magic-attr-select" class="magic-attr-dropdown" name="flags.mythcraft-essence-sheet.magicAttribute" style="background: #151e24; color: #FEEBB3; border: 1px solid #246975; border-radius: 4px; padding: 2px 6px; font-size: 11px; font-weight: 700;">
          {{#each magicAttributeOptions as |opt|}}
            <option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="magic-levels-grid">
      {{#each magicLevels as |ml|}}
        <div class="magic-level-card magic-source-{{ml.colorKey}} {{#if ml.hasSpells}}has-spells{{else}}no-spells{{/if}} {{#if ml.isActive}}filter-active{{/if}}"
             data-action="toggleMagicFilter"
             data-source-key="{{ml.colorKey}}"
             title="{{#if ml.hasSpells}}Click to filter {{ml.label}} spells ({{ml.spellCount}} known){{else}}No {{ml.label}} spells known{{/if}}">
          <div class="magic-level-top">
            <span class="magic-level-label">{{ml.label}}</span>
            {{#if ml.spellCount}}
              <span class="magic-spell-count" title="{{ml.spellCount}} known spell(s)">{{ml.spellCount}}</span>
            {{/if}}
          </div>
          <input type="number"
                 name="{{ml.name}}"
                 value="{{ml.value}}"
                 class="magic-level-input"
                 min="0" max="30"
                 onclick="event.stopPropagation();" />
        </div>
      {{/each}}
    </div>
  </div>

  {{!-- ── Spell List ───────────────────────────────────────── --}}
  <div class="spells-section">
    <div class="inventory-header">
      <h3 class="section-header">
        <i class="fas fa-book-open"></i>
        <span>Spells</span>
      </h3>
      <button type="button"
              class="create-item-btn"
              data-action="createDoc"
              data-document-class="Item"
              data-type="spell"
              title="Add Spell">
        <i class="fas fa-plus"></i>
        <span>Add Spell</span>
      </button>
    </div>

    {{#if spells.length}}
      <ul class="item-list spell-list">
        {{#each spells as |spell|}}
          <li class="item draggable item-row spell-row spell-source-{{spell.magicSourceKey}} {{#if spell.expanded}}expanded{{/if}} {{#if spell.prereqUnmet}}spell-prereq-unmet{{/if}}"
              data-item-id="{{spell.item.id}}"
              data-document-class="Item">

            {{!-- Left side: Spell Image, Name, Special Tags, and 1-Letter Requirements --}}
            <div class="spell-left-group">
              <img class="item-img spell-img"
                   src="{{spell.item.img}}"
                   alt="{{spell.item.name}}"
                   data-action="viewDoc"
                   data-document-class="Item"
                   data-item-id="{{spell.item.id}}" />

              <div class="spell-title-stack">
                <div class="spell-title-line">
                  <span class="item-name spell-name"
                        data-action="toggleItemEmbed"
                        data-document-class="Item"
                        data-item-id="{{spell.item.id}}"
                        title="Click to Toggle Details">
                    {{spell.item.name}}
                  </span>

                  {{#if spell.inlineTags.length}}
                    <div class="spell-inline-tags">
                      {{#each spell.inlineTags as |tag|}}
                        <span class="spell-type-tag tag-{{tag.colorClass}}">{{tag.label}}</span>
                      {{/each}}
                    </div>
                  {{/if}}

                  {{#if spell.requirementBadges.length}}
                    <div class="spell-req-badges" title="Requirements: {{spell.requiresLabel}}">
                      {{#each spell.requirementBadges as |req|}}
                        <span class="spell-req-letter"
                              data-tooltip="Requires: <strong>{{req.label}}</strong>"
                              title="Requires: {{req.label}}">{{req.letter}}</span>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>

                {{#if spell.prereqUnmet}}
                  <div class="spell-prereq-warning" title="{{spell.prereqNote}}">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>{{spell.prereqNote}}</span>
                  </div>
                {{/if}}
              </div>
            </div>

            {{!-- Right side: Source Badge, Target, AP, SP, Action Buttons --}}
            <div class="spell-right-group">
              {{#if spell.magicSourceLabel}}
                <span class="spell-source-badge source-badge-{{spell.magicSourceKey}}">{{spell.magicSourceLabel}}</span>
              {{/if}}

              {{#if spell.targetDefenseConfig}}
                <span class="spell-target-badge def-{{spell.targetDefenseConfig.key}}"
                      style="--def-color: {{spell.targetDefenseConfig.color}}; --def-bg: {{spell.targetDefenseConfig.bg}}; --def-border: {{spell.targetDefenseConfig.border}};"
                      data-tooltip="Target Defense: <strong>{{spell.targetDefenseConfig.label}} ({{spell.targetDefenseConfig.abbr}})</strong>"
                      title="Target Defense: {{spell.targetDefenseConfig.label}} ({{spell.targetDefenseConfig.abbr}})">
                  {{#if spell.isAttack}}<span class="vs-prefix">vs</span>{{/if}}
                  <i class="{{spell.targetDefenseConfig.icon}} def-icon"></i>
                  <span class="def-abbr">{{spell.targetDefenseConfig.abbr}}</span>
                </span>
              {{else if spell.targetDefense}}
                <span class="spell-target-badge" title="Target Defense / Check: {{spell.targetDefense}}">
                  {{#if spell.isAttack}}vs {{spell.targetDefense}}{{else}}{{spell.targetDefense}}{{/if}}
                </span>
              {{/if}}

              {{#if spell.displayApc}}
                <span class="spell-cost-badge" title="Action Points Cost">
                  <i class="fas fa-bolt"></i>
                  {{spell.displayApc}} AP
                </span>
              {{/if}}

              {{#if spell.displaySpc}}
                <span class="spell-cost-badge sp-cost-badge" title="Spell Points Cost">
                  <i class="fas fa-hat-wizard"></i>
                  {{spell.displaySpc}} SP
                </span>
              {{/if}}

              <div class="item-actions">
                {{#if spell.isAttack}}
                  <select class="spell-attribute-dropdown" data-spell-attribute data-item-id="{{spell.item.id}}" title="Attribute used for this spell attack">
                    <option value="" {{#unless spell.spellcastingAttribute}}selected{{/unless}}>Global</option>
                    {{#each spell.spellAttributeOptions as |opt|}}
                      <option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.abbr}}</option>
                    {{/each}}
                  </select>
                {{/if}}
                <button type="button"
                        class="item-action-btn roll-btn cast-btn {{#unless spell.isAttack}}non-attack-cast-btn{{/unless}}"
                        data-action="rollSpell"
                        data-item-id="{{spell.item.id}}"
                        title="{{#if spell.isAttack}}Roll Spell Attack ({{spell.targetDefense}}){{else}}Cast Spell to Chat (Non-Attack){{/if}}">
                  <i class="fas fa-{{#if spell.isAttack}}dice-d20{{else}}wand-magic-sparkles{{/if}}"></i>
                </button>
                <button type="button"
                        class="item-action-btn chat-btn post-spell-btn"
                        data-action="postSpellToChat"
                        data-item-id="{{spell.item.id}}"
                        title="Post Spell Description to Chat">
                  <i class="fas fa-comment-alt"></i>
                </button>
                <button type="button"
                        class="item-action-btn edit-btn"
                        data-action="viewDoc"
                        data-document-class="Item"
                        data-item-id="{{spell.item.id}}"
                        title="Edit Spell">
                  <i class="fas fa-edit"></i>
                </button>
                <button type="button"
                        class="item-action-btn expand-btn"
                        data-action="toggleItemEmbed"
                        data-item-id="{{spell.item.id}}"
                        title="Expand / Collapse Details">
                  <i class="fas fa-chevron-{{#if spell.expanded}}up{{else}}down{{/if}}"></i>
                </button>
                <button type="button"
                        class="item-action-btn delete-btn"
                        data-action="deleteDoc"
                        data-document-class="Item"
                        data-item-id="{{spell.item.id}}"
                        title="Delete Spell">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>


            {{!-- Expanded Embed / Description --}}
            {{#if spell.expanded}}
              <div class="item-embed-card spell-embed">
                {{#if spell.tags.length}}
                  <div class="spell-embed-tags expanded-tags-strip">
                    {{#each spell.tags as |tag|}}
                      <span class="tag-badge-pill {{tag.category}}" 
                            style="--cat-color: {{tag.categoryMeta.color}}; --cat-bg: {{tag.categoryMeta.bg}}; --cat-border: {{tag.categoryMeta.border}};"
                            data-tooltip="{{tag.tooltipHTML}}"
                            data-tooltip-direction="UP">
                        <i class="{{tag.categoryMeta.icon}}"></i>
                        <span class="tag-badge-name">{{tag.name}}</span>
                      </span>
                    {{/each}}
                  </div>
                {{/if}}

                <div class="spell-library-meta-grid">
                  {{#if spell.spellTypeLabel}}<span><strong>Type:</strong> {{spell.spellTypeLabel}}</span>{{/if}}
                  {{#if spell.functionLabel}}<span><strong>Function:</strong> {{spell.functionLabel}}</span>{{/if}}
                  {{#if spell.rangeLabel}}<span><strong>Range:</strong> {{spell.rangeLabel}}</span>{{/if}}
                  {{#if spell.durationLabel}}<span><strong>Duration:</strong> {{spell.durationLabel}}</span>{{/if}}
                  {{#if spell.requiresLabel}}<span><strong>Requires:</strong> {{spell.requiresLabel}}</span>{{/if}}
                  {{#if spell.castingTimeLabel}}<span><strong>Casting Time:</strong> {{spell.castingTimeLabel}}</span>{{/if}}
                  {{#if spell.prereqText}}<span class="{{#if spell.prereqUnmet}}prereq-unmet-text{{/if}}"><strong>Prerequisite:</strong> {{spell.prereqText}}</span>{{/if}}
                  {{#if spell.materialsText}}<span><strong>Materials:</strong> {{spell.materialsText}}</span>{{/if}}
                </div>

                {{#if spell.upchargeText}}
                  <div class="spell-library-upcharge-box">
                    <strong><i class="fas fa-bolt"></i> Upcharge / Scaling:</strong> {{spell.upchargeText}}
                  </div>
                {{/if}}

                <div class="spell-embed-body">
                  {{#if spell.descriptionHTML}}
                    {{{spell.descriptionHTML}}}
                  {{else if spell.item.system.description.value}}
                    {{{spell.item.system.description.value}}}
                  {{else}}
                    <p class="empty-desc-hint">No spell description available.</p>
                  {{/if}}
                </div>
              </div>
            {{/if}}

          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="empty-list-msg">No spells match the selected filter(s).</p>
    {{/if}}

  </div>

</section>
