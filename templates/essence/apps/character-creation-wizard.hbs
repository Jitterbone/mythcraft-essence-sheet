                      <span class="confirmed-badge"><i class="fas fa-check-circle"></i> Selected: {{selectedProfession2.name}}</span>
                    {{/if}}
                  </div>
                  <p class="choice-guidance">As a Knave, you gain two professions. Your second profession must be different from the first.</p>

                  <div class="bops-list-grid">
                    {{#each availableProfessions2 as |prof|}}
                      <div class="bops-item-card {{#if (eq ../data.selectedProfessionId2 prof.id)}}selected{{/if}} {{#if prof.isEncouraged}}encouraged-gold{{/if}}"
                           data-action="selectProfession2"
                           data-profession-id="{{prof.id}}"
                           data-card-id="{{prof.id}}-2">
                        <img src="{{prof.img}}" alt="{{prof.name}}" />
                        <div class="bops-item-info">
                          <div class="bops-card-title-row">
                            <h5>{{prof.name}}</h5>
                            {{#if (eq ../data.selectedProfessionId2 prof.id)}}
                              <span class="selected-pill-badge"><i class="fas fa-circle-check"></i> Selected</span>
                            {{/if}}
                          </div>
                          {{#if prof.parsed.tags.length}}
                            <div class="prof-card-tags">
                              {{#each prof.parsed.tags as |tag|}}
                                <span class="prof-tag-chip">{{tag}}</span>
                              {{/each}}
                            </div>
                          {{/if}}
                          <div class="prof-card-skill-summary">
                            {{#each prof.parsed.fixedSkills as |sk|}}
                              <span class="prof-mini-skill">+{{sk.value}} {{sk.name}}</span>
                            {{/each}}
                            {{#if prof.parsed.choiceSkills.count}}
                              <span class="prof-mini-skill choice">{{prof.parsed.choiceSkills.count}}&times; +{{prof.parsed.choiceSkills.value}} Choice</span>
                            {{/if}}
                          </div>
                          {{#if prof.isEncouraged}}
                            <span class="encouraged-pill" data-tooltip="Grants background synergy bonus">
                              <i class="fas fa-star"></i> +{{@root.parsedBackground.encouragedProfessions.bonusValue}} {{@root.parsedBackground.encouragedProfessions.bonusSkill}} ({{@root.selectedBackground.name}})
                            </span>
                          {{/if}}
                        </div>
                      </div>
                    {{/each}}
                  </div>

                  {{#if (and selectedProfession2 parsedProfession2)}}
                    <div class="profession-detail-subpanel ccx-animated-reveal">
                      <div class="profession-summary-header">
                        <div class="prof-header-left">
                          <h5><i class="fas fa-circle-check"></i> {{selectedProfession2.name}} (Rank 1)</h5>
                          {{#if parsedProfession2.tags.length}}
                            <div class="prof-card-tags">
                              {{#each parsedProfession2.tags as |tag|}}
                                <span class="prof-tag-chip">{{tag}}</span>
                              {{/each}}
                            </div>
                          {{/if}}
                        </div>
                        {{#if selectedProfession2.isEncouraged}}
                          <span class="encouraged-pill"><i class="fas fa-star"></i> Background Synergy: +{{parsedBackground.encouragedProfessions.bonusValue}} {{parsedBackground.encouragedProfessions.bonusSkill}}</span>
                        {{/if}}
                      </div>

                      {{#if parsedProfession2.description}}
                        <div class="prof-description-box">
                          <p>{{parsedProfession2.description}}</p>
                        </div>
                      {{/if}}

                      <div class="rank-features-box">
                        <h6 class="box-sub"><i class="fas fa-award"></i> Rank 1 Benefit{{#if parsedProfession2.benefitTitle}} — {{parsedProfession2.benefitTitle}}{{/if}}:</h6>
                        {{#if parsedProfession2.benefitSummary}}
                          <div class="profession-rank-row">
                            <p>{{parsedProfession2.benefitSummary}}</p>
                          </div>
                        {{else if professionRankItems2.length}}
                          {{#each professionRankItems2 as |rank|}}
                            <div class="profession-rank-row">
                              <strong>{{rank.name}}</strong>
                              <div>{{{rank.system.description.value}}}</div>
                            </div>
                          {{/each}}
                        {{/if}}
                      </div>

                      <div class="prof-skills-box">
                        <h6 class="box-sub"><i class="fas fa-book"></i> Automatic Profession Skills:</h6>
                        <div class="fixed-skills-row">
                          {{#each parsedProfession2.fixedSkills as |skill|}}
                            <span class="prof-skill-pill fixed"><i class="fas fa-plus"></i> {{skill.value}} {{skill.name}}</span>
                          {{/each}}
                        </div>

                        {{#if parsedProfession2.choiceSkills.count}}
                          <div class="choice-skills-header-row">
                            <h6 class="box-sub"><i class="fas fa-hand-pointer"></i> Choose {{parsedProfession2.choiceSkills.count}} Additional Skills (+{{parsedProfession2.choiceSkills.value}} each):</h6>
                            <span class="used-pill {{#if (eq data.selectedProfessionSkills2.length parsedProfession2.choiceSkills.count)}}complete{{else}}pending{{/if}}">
                              Selected: {{data.selectedProfessionSkills2.length}} / {{parsedProfession2.choiceSkills.count}}
                            </span>
                          </div>
                          <div class="choice-skills-wrap">
                            {{#each parsedProfession2.choiceSkills.options as |opt|}}
                              <label class="choice-skill-toggle {{#if (includes ../data.selectedProfessionSkills2 opt)}}checked{{/if}}">
                                <input type="checkbox" data-action="toggleProfessionSkill2" data-skill="{{opt}}"
                                       {{#if (includes ../data.selectedProfessionSkills2 opt)}}checked{{/if}} />
                                <i class="fas {{#if (includes ../data.selectedProfessionSkills2 opt)}}fa-check-square{{else}}fa-square{{/if}}"></i>
                                <span>+{{../parsedProfession2.choiceSkills.value}} {{opt}}</span>
                              </label>
                            {{/each}}
                          </div>
                        {{/if}}
                      </div>

                      {{#if parsedProfession2.startingGear.length}}
                        <div class="prof-gear-box">
                          <h6 class="box-sub"><i class="fas fa-shield"></i> Starting Equipment:</h6>
                          <div class="gear-preview-chips">
                            {{#each parsedProfession2.startingGear as |gear|}}
                              <span class="gear-chip">
                                {{#if gear.img}}<img src="{{gear.img}}" class="gear-chip-img" alt="{{gear.name}}" />{{/if}}
                                <span class="gear-chip-name">{{gear.name}}</span>
                                {{#if (gt gear.quantity 1)}}<span class="gear-chip-qty">&times;{{gear.quantity}}</span>{{/if}}
                              </span>
                            {{/each}}
                          </div>
                        </div>
                      {{/if}}
                    </div>
                  {{/if}}
                </div>
              {{/if}}

              {{#if data.backgroundConfirmed}}
                <div class="ccx-stage-confirm-bar">
                  <button type="button" class="ccx-stage-advance-btn" data-action="nextStep">
                    <span>Confirm Background &amp; Calling &amp; Pan to Talents</span>
                    <i class="fas fa-arrow-right-long"></i>
                  </button>
                </div>
              {{/if}}
            </div>
          </section>

          {{else if (eq step 5)}}
          {{!-- ======================================================
               STAGE 5: TALENTS
               ====================================================== --}}
          <section class="ccx-stage-slide is-active" data-stage-slide="5">
            <div class="wizard-step-panel step-talents ccx-stage-scroll" data-stage="5">
              <div class="wizard-panel-header ccx-hero-stage-banner">
                <div class="ccx-stage-emblem"><i class="fas fa-sparkles"></i></div>
                <div class="ccx-stage-banner-text">
                  <span class="ccx-stage-overline">STAGE 05 &bull; SPECIALIZATION &amp; MAGIC GATEWAY</span>
                  <h3>Starting Talents &amp; Magic</h3>
                  <p>Characters at level 1 can choose 1 <strong>Specialization Talent</strong> or <strong>Magic Entry Talent</strong> (Class Talents unlock at level 2). Stacks from official compendiums are organized below.</p>
                </div>
              </div>

              <div class="wizard-search-bar">
                <i class="fas fa-search"></i>
                <input class="wizard-search-input" type="search" data-search="talent" value="{{data.searches.talent}}" placeholder="Search starting talents..." />
              </div>

              {{#each filteredTalentGroups as |group|}}
                <section class="talent-source-group">
                  <h4 class="talent-source-title"><i class="fas fa-layer-group"></i> {{group.label}}</h4>
                  {{#each group.stacks as |stack|}}
                    <div class="talent-stack-block">
                      <div class="talent-stack-title-bar">
                        <span class="talent-stack-name"><i class="fas fa-folder-tree"></i> {{stack.stackName}}</span>
                        <span class="talent-stack-count">{{stack.items.length}} Option{{#if (gt stack.items.length 1)}}s{{/if}}</span>
                      </div>
                      <div class="talents-selection-list">
                        {{#each stack.items as |talent|}}
                          <div class="talent-choice-card {{#if (eq @root.data.selectedTalentId talent.id)}}selected{{/if}} {{#unless talent.isAvailable}}locked{{/unless}}"
                               data-action="selectTalent"
                               data-talent-id="{{talent.id}}"
                               data-locked="{{#unless talent.isAvailable}}true{{else}}false{{/unless}}"
                               {{#unless talent.isAvailable}}data-tooltip="{{talent.prereqTooltip}}"{{/unless}}>
                            <div class="talent-card-left">
                              <img src="{{talent.img}}" alt="{{talent.name}}" />
                              <div class="talent-info">
                                <div class="talent-title-line">
                                  <h4>{{talent.name}}</h4>
                                  {{#unless talent.isAvailable}}
                                    <span class="prereq-badge"><i class="fas fa-lock"></i> Locked</span>
                                  {{/unless}}
                                </div>
                                {{#if talent.shortDesc}}
                                  <p class="talent-short-desc">{{talent.shortDesc}}</p>
                                {{/if}}
                              </div>
                            </div>
                            <div class="talent-card-right">
                              <i class="fas {{#if (eq @root.data.selectedTalentId talent.id)}}fa-circle-check{{else if talent.isAvailable}}fa-circle{{else}}fa-lock{{/if}}"></i>
                            </div>
                          </div>
                        {{/each}}
                      </div>
                    </div>
                  {{/each}}
                </section>
              {{/each}}

              {{#if selectedTalent}}
                <div class="lineage-detail-box talent-detail-box ccx-animated-reveal">
                  <div class="detail-header">
                    <div class="detail-title-wrap">
                      <img class="detail-thumb" src="{{selectedTalent.img}}" alt="{{selectedTalent.name}}" />
                      <h4>{{selectedTalent.name}}</h4>
                    </div>
                  </div>
                  <div class="detail-content-box">{{{selectedTalent.system.description.value}}}</div>
                </div>
              {{/if}}

              {{#if parsedTalent.extraStackTalents}}
                <div class="extra-talents-box ccx-animated-reveal">
                  <h4><i class="fas fa-plus"></i> Choose {{parsedTalent.extraStackTalents}} Additional Stack Talents:</h4>
                  <div class="extra-talents-list">
                    {{#each extraTalentOptions as |extra|}}
                      <button type="button" class="extra-talent-btn {{#if (includes ../data.selectedExtraTalentIds extra.id)}}active{{/if}} {{#unless extra.isAvailable}}disabled{{/unless}}"
                              data-action="toggleExtraTalent"
                              data-talent-id="{{extra.id}}"
                              {{#unless extra.isAvailable}}disabled title="{{extra.prereqTooltip}}"{{/unless}}>
                        {{extra.name}} {{#unless extra.isAvailable}}<i class="fas fa-lock"></i>{{/unless}}
                      </button>
                    {{/each}}
                  </div>
                </div>
              {{/if}}

              {{#if parsedTalent.isMagicEntry}}
                <div class="spells-picker-box ccx-animated-reveal">
                  <h4><i class="fas fa-wand-magic"></i> Pick Spells:</h4>
                  <div class="magic-attr-row">
                    <label>Magic Attribute:</label>
                    <select name="magicAttr" data-action="setMagicAttribute">
                      {{#each magicAttributeOptions as |opt|}}
                        <option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div class="spells-selection-grid">
                    <div class="wizard-search-bar">
                      <i class="fas fa-search"></i>
                      <input class="wizard-search-input" type="search" data-search="spell" value="{{data.searches.spell}}" placeholder="Search spells..." />
                    </div>
                    <div class="spells-cards-wrap">
                      {{#each filteredSpells as |spell|}}
                        <div class="spell-select-card {{#if (includes ../data.selectedSpellIds spell.id)}}active{{/if}}"
                             data-action="toggleSpell"
                             data-spell-id="{{spell.id}}">
                          <img src="{{spell.img}}" alt="{{spell.name}}" />
                          <span class="spell-name">{{spell.name}}</span>
                        </div>
                      {{/each}}
                    </div>
                  </div>
                </div>
              {{/if}}

              {{#if selectedTalent}}
                <div class="ccx-stage-confirm-bar">
                  <button type="button" class="ccx-stage-advance-btn" data-action="nextStep">
                    <span>Confirm Talents &amp; Pan to Character Overview</span>
                    <i class="fas fa-arrow-right-long"></i>
                  </button>
                </div>
              {{/if}}
            </div>
          </section>

          {{else if (eq step 6)}}
          {{!-- ======================================================
               STAGE 6: CHARACTER OVERVIEW
               ====================================================== --}}
          <section class="ccx-stage-slide is-active" data-stage-slide="6">
            <div class="wizard-step-panel step-finalize ccx-stage-scroll" data-stage="6">
              <div class="wizard-panel-header ccx-hero-stage-banner">
                <div class="ccx-stage-emblem"><i class="fas fa-crown"></i></div>
                <div class="ccx-stage-banner-text">
                  <span class="ccx-stage-overline">STAGE 06 &bull; COMPLETE BUILD BLUEPRINT</span>
                  <h3>Character Overview</h3>
                  <p>Inspect your complete character hierarchy below. Click any node to pan back and adjust, or awaken your character onto the sheet.</p>
                </div>
              </div>

              {{!-- Full Visual Build Hierarchy Diagram --}}
              <div class="ccx-constellation-diagram">
                {{!-- Root Crown Node --}}
                <div class="ccx-diagram-crown-node">
                  <img src="{{actor.img}}" alt="{{actor.name}}" />
                  <div>
                    <h4>{{actor.name}}</h4>
                    <span>Level 1 Adventurer &bull; {{calculatedAp}} AP &bull; {{#if (eq data.hpMode 'set')}}{{setHpValue}} HP{{else}}11 + 1{{hpData.die}} HP{{/if}}</span>
                  </div>
                </div>

                <div class="ccx-diagram-trunk-stem"></div>

                {{!-- 4-Pillar Branching Architecture --}}
                <div class="ccx-diagram-pillars-grid">
                  {{!-- Pillar 1: Lineage & Traits --}}
                  <div class="ccx-pillar-card" data-action="jumpToStep" data-step="1">
                    <div class="ccx-pillar-head"><i class="fas fa-dna"></i> Origin &amp; Lineage</div>
                    <div class="ccx-pillar-main">
                      {{#if selectedLineage}}
                        <div class="ccx-node-pill gold">
                          <img src="{{selectedLineage.img}}" alt="{{selectedLineage.name}}" />
                          <strong>{{selectedLineage.name}}</strong>
                        </div>
                        {{#if selectedSublineage}}
                          <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                          <div class="ccx-node-pill teal"><i class="fas fa-code-branch"></i> {{selectedSublineage.name}}</div>
                        {{/if}}
                        {{#each baseStartingFeatures as |f|}}
                          <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                          <div class="ccx-node-pill"><img src="{{f.img}}" alt="{{f.name}}" /> {{f.name}}</div>
                        {{/each}}
                        {{#if selectedSublineage}}
                          {{#each selectedSublineage.features as |f|}}
                            <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                            <div class="ccx-node-pill"><img src="{{f.img}}" alt="{{f.name}}" /> {{f.name}}</div>
                          {{/each}}
                        {{/if}}
                        {{#each selectedUniqueFeatures as |f|}}
                          <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                          <div class="ccx-node-pill"><img src="{{f.img}}" alt="{{f.name}}" /> {{f.name}}</div>
                        {{/each}}
                      {{else}}
                        <span class="ccx-empty-note">No Lineage Selected</span>
                      {{/if}}
                    </div>
                  </div>

                  {{!-- Pillar 2: Attributes & Defenses --}}
                  <div class="ccx-pillar-card" data-action="jumpToStep" data-step="2">
                    <div class="ccx-pillar-head"><i class="fas fa-chart-simple"></i> Attributes &amp; Defenses</div>
                    <div class="ccx-pillar-main">
                      {{#if attributeRadarSvg}}
                        <div class="ccx-pillar-radar-mini">
                          {{{attributeRadarSvg}}}
                        </div>
                      {{/if}}
                      <div class="ccx-h-attr-mini-grid">
                        {{#each attributesList as |attr|}}
                          <div class="ccx-mini-attr {{#if (gt attr.value 0)}}pos{{else if (lt attr.value 0)}}neg{{/if}}">
                            <span class="k">{{attr.label}}</span>
                            <span class="v">{{#if (gt attr.value 0)}}+{{/if}}{{attr.value}}</span>
                          </div>
                        {{/each}}
                      </div>
                      <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                      <div class="ccx-h-def-pills">
                        <span>AR 10</span>
                        <span>REF {{add 10 data.attributes.dex}}</span>
                        <span>FORT {{add 10 data.attributes.end}}</span>
                        <span>ANT {{add 10 data.attributes.awr}}</span>
                        <span>LOG {{add 10 data.attributes.int}}</span>
                        <span>WILL {{add 10 data.attributes.cha}}</span>
                      </div>
                    </div>
                  </div>

                  {{!-- Pillar 3: Background & Profession --}}
                  <div class="ccx-pillar-card" data-action="jumpToStep" data-step="4">
                    <div class="ccx-pillar-head"><i class="fas fa-scroll"></i> Background &amp; Calling</div>
                    <div class="ccx-pillar-main">
                      {{#if selectedBackground}}
                        <div class="ccx-node-pill gold">
                          <img src="{{selectedBackground.img}}" alt="{{selectedBackground.name}}" />
                          <strong>{{selectedBackground.name}}</strong>
                        </div>
                      {{/if}}
                      {{#if selectedProfession}}
                        <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                        <div class="ccx-node-pill teal">
                          <img src="{{selectedProfession.img}}" alt="{{selectedProfession.name}}" />
                          <strong>{{selectedProfession.name}} (Rank 1)</strong>
                        </div>
                      {{/if}}
                      {{#if selectedProfession2}}
                        <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                        <div class="ccx-node-pill teal">
                          <img src="{{selectedProfession2.img}}" alt="{{selectedProfession2.name}}" />
                          <strong>{{selectedProfession2.name}} (Rank 1)</strong>
                        </div>
                      {{/if}}
                      {{#if allocatedSkillsList.length}}
                        <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                        <div class="ccx-h-skill-cloud">
                          {{#each allocatedSkillsList as |sk|}}
                            <span class="ccx-h-skill-tag">+{{sk.value}} {{sk.name}}</span>
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  </div>

                  {{!-- Pillar 4: Starting Talents & Spells --}}
                  <div class="ccx-pillar-card" data-action="jumpToStep" data-step="5">
                    <div class="ccx-pillar-head"><i class="fas fa-sparkles"></i> Talent &amp; Magic</div>
                    <div class="ccx-pillar-main">
                      {{#if selectedTalent}}
                        <div class="ccx-node-pill gold">
                          <img src="{{selectedTalent.img}}" alt="{{selectedTalent.name}}" />
                          <strong>{{selectedTalent.name}}</strong>
                        </div>
                        {{#each selectedExtraTalents as |ext|}}
                          <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                          <div class="ccx-node-pill teal">
                            <img src="{{ext.img}}" alt="{{ext.name}}" />
                            <span>{{ext.name}}</span>
                          </div>
                        {{/each}}
                        {{#if selectedSpells.length}}
                          <div class="ccx-node-sub-arrow"><i class="fas fa-arrow-down"></i></div>
                          <div class="ccx-h-skill-cloud">
                            {{#each selectedSpells as |sp|}}
                              <span class="ccx-h-skill-tag spell"><i class="fas fa-wand-sparkles"></i> {{sp.name}}</span>
                            {{/each}}
                          </div>
                        {{/if}}
                      {{else}}
                        <span class="ccx-empty-note">No Talent Selected</span>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>

              <button type="button" class="wizard-finalize-btn ccx-awaken-hero-btn" data-action="finalize">
                <i class="fas fa-wand-magic-sparkles"></i> Complete &amp; Populate Character Sheet
              </button>
            </div>
          </section>
          {{/if}}

        </div>
      </div>

      {{!-- Wizard Footer Controls --}}
      <footer class="wizard-footer-controls ccx-bottom-hud-bar">
        {{#if (gt step 1)}}
          <button type="button" class="wizard-nav-btn prev" data-action="prevStep">
            <i class="fas fa-arrow-left"></i> Previous Stage
          </button>
        {{else}}
          <div></div>
        {{/if}}

        <div class="ccx-hud-step-dots">
          <span class="ccx-dot {{#if (eq step 1)}}active{{/if}} {{#if (gt step 1)}}done{{/if}}" data-action="jumpToStep" data-step="1"></span>
          <span class="ccx-dot {{#if (eq step 2)}}active{{/if}} {{#if (gt step 2)}}done{{/if}}" data-action="jumpToStep" data-step="2"></span>
          <span class="ccx-dot {{#if (eq step 3)}}active{{/if}} {{#if (gt step 3)}}done{{/if}}" data-action="jumpToStep" data-step="3"></span>
          <span class="ccx-dot {{#if (eq step 4)}}active{{/if}} {{#if (gt step 4)}}done{{/if}}" data-action="jumpToStep" data-step="4"></span>
          <span class="ccx-dot {{#if (eq step 5)}}active{{/if}} {{#if (gt step 5)}}done{{/if}}" data-action="jumpToStep" data-step="5"></span>
          <span class="ccx-dot {{#if (eq step 6)}}active{{/if}}" data-action="jumpToStep" data-step="6"></span>
        </div>

        {{#if (lt step 6)}}
          <button type="button" class="wizard-nav-btn next" data-action="nextStep">
            Confirm &amp; Pan Next <i class="fas fa-arrow-right"></i>
          </button>
        {{else}}
          <button type="button" class="wizard-nav-btn next finalize-hud-btn" data-action="finalize">
            <i class="fas fa-wand-magic-sparkles"></i> Awaken Hero
          </button>
        {{/if}}
      </footer>

    </main>

  </div>

</div>
