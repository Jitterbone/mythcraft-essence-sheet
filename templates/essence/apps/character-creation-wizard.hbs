                          <h6 class="box-sub"><i class="fas fa-award"></i> Rank 1 Benefit{{#if parsedProfession.benefitTitle}} — {{parsedProfession.benefitTitle}}{{/if}}:</h6>
                          {{#if parsedProfession.benefitSummary}}
                            <div class="profession-rank-row">
                              <p>{{parsedProfession.benefitSummary}}</p>
                            </div>
                          {{else if professionRankItems.length}}
                            {{#each professionRankItems as |rank|}}
                              <div class="profession-rank-row">
                                <strong>{{rank.name}}</strong>
                                <div>{{{rank.system.description.value}}}</div>
                              </div>
                            {{/each}}
                          {{/if}}
                        </div>

                        <div class="prof-skills-box">
                          <h6 class="box-sub"><i class="fas fa-book"></i> Automatic Profession Skills:</h6>
