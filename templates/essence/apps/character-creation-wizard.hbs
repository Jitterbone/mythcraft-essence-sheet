                              <span class="prof-skill-pill fixed"><i class="fas fa-plus"></i> {{skill.value}} {{skill.name}}</span>
                            {{/each}}
                            {{#if selectedProfession.isEncouraged}}
                              <span class="prof-skill-pill synergy"><i class="fas fa-star"></i> +{{parsedBackground.encouragedProfessions.bonusValue}} {{parsedBackground.encouragedProfessions.bonusSkill}} ({{selectedBackground.name}} Bonus)</span>
                            {{/if}}
                          </div>

                          {{#if parsedProfession.choiceSkills.count}}
